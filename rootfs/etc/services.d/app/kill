#!/bin/sh
#
# Firefox doesn't gracefully shutdown when receiving SIGTERM.  For example, last
# opened tabs may not be saved.  Instead, terminate Firefox by sending the
# CTRL+q key presses.
#

set -e # Exit immediately if a command exits with a non-zero status.
set -u # Treat unset variables as an error.

PID="${1:-}"
case "$PID" in
    ''|*[!0-9]*|0|1) exit 1 ;;
esac

WINDOW="$(xdotool search --onlyvisible --all --pid "$PID" --class firefox 2>/dev/null | head -n 1)"
if [ -n "$WINDOW" ]; then
    xdotool key --window "$WINDOW" "Escape" "ctrl+q" 2>/dev/null || true
fi

i=0
while [ "$i" -lt 10 ]
do
    kill -0 "$PID" 2>/dev/null || break
    sleep 0.5
    i=$((i + 1))
done

